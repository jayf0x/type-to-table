{
  "name": "type-to-table",
  "version": "1.0.0",
  "type": "module",
  "description": "Read a .tsx component's props, pull the JSDoc per prop (including @default), and write a markdown table into your README between marker comments. No manual props-docs sync, ever.",
  "author": "jayF0x",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "react-docgen-typescript": "^2.4.0",
    "taglify": "^1.2.0"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config config/vite.config.ts",
    "dev": "vite build --watch --config config/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:run": "bun test",
    "docs:props": "bun scripts/docs-props.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "scan": "bash ./scripts/opengrep-scan.sh",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "npm:deploy": "bash ./scripts/npm/publish-npm.sh",
    "repo:bootstrap": "bash ./scripts/bootstap.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/react": "^19.2.17",
    "bun-types": "^1.3.14",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "typescript",
    "tsx",
    "jsdoc",
    "react-docgen-typescript",
    "props-table",
    "readme",
    "docs",
    "docgen",
    "markdown",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayf0x/type-to-table.git"
  },
  "homepage": "https://github.com/jayf0x/type-to-table#readme",
  "bugs": {
    "url": "https://github.com/jayf0x/type-to-table/issues"
  }
}
